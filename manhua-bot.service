[Unit]
Description=漫画下载 Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/manhua
Environment=MANGA_PROXY=socks5://127.0.0.1:10809
ExecStart=/data/manhua/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=manhua-bot

[Install]
WantedBy=multi-user.target
